{% extends 'base.html.twig' %}

{% block title %}Moulinette GEIQ{% endblock %}

{% block body %}
<div class="content-card">
    <h1 class="page-title">Moulinette GEIQ</h1>

    {% if message %}
        <div class="alert alert-{{ message[0] }}">
            <i class="fas fa-{{ message[0] == 'success' ? 'check-circle' : (message[0] == 'danger' ? 'exclamation-circle' : 'info-circle') }}"></i>
            {{ message[1]|raw }}
        </div>
    {% endif %}

    <form method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label><i class="fas fa-map-marker-alt"></i> Territoire</label>
            <div class="radio-group">
                <label>
                    <input type="radio" name="territory" value="nord"
                           {{ selectedTerritory == 'nord' ? 'checked' : '' }}>
                    Nord
                </label>
                <label>
                    <input type="radio" name="territory" value="idf"
                           {{ selectedTerritory == 'idf' ? 'checked' : '' }}>
                    IDF
                </label>
            </div>
        </div>

        <div class="form-group">
            <label for="dsn_file">
                <i class="fas fa-file-pdf"></i> DSN PDF
            </label>
            <input type="file" id="dsn_file" name="dsn_file" accept=".pdf" required>
        </div>

        <div class="form-group">
            <label for="totalisation_file">
                <i class="fas fa-file-pdf"></i> Totalisation par services PDF
            </label>
            <input type="file" id="totalisation_file" name="totalisation_file" accept=".pdf" required>
        </div>

        <div class="form-group">
            <label for="control_file">
                <i class="fas fa-file-excel"></i> Fichier Excel de contrôle
            </label>
            <input type="file" id="control_file" name="control_file" accept=".xlsx,.xls" required>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <i class="fas fa-rocket"></i> Générer le contrôle GEIQ
            </button>
        </div>
    </form>
</div>
{% endblock %}
